import os, json, re

try:
    _base = os.path.dirname(os.path.abspath(__file__))
except NameError:
    _base = os.getcwd()
_taught_file = os.path.join(_base, 'taught_words.json')

try:
    with open(_taught_file, 'r', encoding='utf-8') as _f:
        _taught = json.load(_f)
except Exception:
    _taught = {}

def _builtin_words():
    words = {}
    try:
        with open(os.path.abspath(__file__), 'r', encoding='utf-8') as _f:
            _src = _f.read().split('# ===== expert mode =====')[0]
        for k, v in re.findall(r"if hello == '(.*?)':\s*print\('(.*?)'\)", _src):
            words[k.lower()] = v
    except Exception:
        pass
    return words

